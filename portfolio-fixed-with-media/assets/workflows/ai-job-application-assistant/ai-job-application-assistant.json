        "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body { font-family: Arial, Helvetica, sans-serif; color: #222; margin: 40px; line-height: 1.6; font-size: 13px; }\n  h1 { font-size: 22px; margin: 0; color: #3730a3; }\n  .email { color: #666; margin-bottom: 20px; }\n  h2 { font-size: 15px; color: #3730a3; border-bottom: 2px solid #e0e7ff; padding-bottom: 4px; margin-top: 28px; }\n  p { margin: 0 0 10px; }\n</style>\n</head>\n<body>\n  <h1>{{ $('Edit Fields').item.json.name }}</h1>\n  <div class=\"email\">{{ $('Edit Fields').item.json.email }}</div>\n\n  <h2>Cover Letter</h2>\n  <p>{{ $json.output.cover_letter.replace(/\\n/g, '<br>') }}</p>\n\n  <h2>Resume Summary</h2>\n  <p>{{ $json.output.resume_summary.replace(/\\n/g, '<br>') }}</p>\n</body>\n</html>"
