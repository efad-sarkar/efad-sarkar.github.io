    {
      "parameters": {
        "jsCode": "\nconst orders = $input.all().map(item => item.json);\n\nconst validOrders = orders.filter(order =>\n  !['cancelled', 'failed', 'trash'].includes(order.status)\n);\n\nlet totalSales = 0;\nlet totalTax = 0;\nlet totalItemsSold = 0;\nlet totalRefunds = 0;\n\nconst productSales = {};\nconst customerOrders = {};\n\nfor (const order of validOrders) {\n  totalSales += Number(order.total || 0);\n  totalTax += Number(order.total_tax || 0);\n\n  for (const product of order.line_items || []) {\n    const qty = Number(product.quantity || 0);\n    totalItemsSold += qty;\n\n    const name = product.name || 'Unknown Product';\n    productSales[name] = (productSales[name] || 0) + qty;\n  }\n\n  const customerId = order.customer_id\n    ? `customer_${order.customer_id}`\n    : `guest_${order.billing?.email || order.id}`;\n\n  customerOrders[customerId] =\n    (customerOrders[customerId] || 0) + 1;\n\n  for (const refund of order.refunds || []) {\n    totalRefunds += Math.abs(Number(refund.total || 0));\n  }\n}\n\nconst bestSellingProduct = Object.entries(productSales)\n  .sort((a, b) => b[1] - a[1])[0];\n\nconst customerCounts = Object.values(customerOrders);\n\nreturn [{\n  json: {\n    report_date: $now.toISODate(),\n    total_orders: validOrders.length,\n    total_sales: Number(totalSales.toFixed(2)),\n    total_tax_collected: Number(totalTax.toFixed(2)),\n    total_items_sold: totalItemsSold,\n    best_selling_product: bestSellingProduct\n      ? bestSellingProduct[0]\n      : 'No sales',\n    new_vs_returning_customers: {\n      unique_customers: customerCounts.length,\n      repeat_customers: customerCounts.filter(count => count > 1).length\n    },\n    total_refunds: Number(totalRefunds.toFixed(2)),\n    invoice_links: validOrders.map(order => ({\n      order_id: order.id,\n      invoice_url: order.invoice_url || null\n    }))\n  }\n}];\n"
      },
