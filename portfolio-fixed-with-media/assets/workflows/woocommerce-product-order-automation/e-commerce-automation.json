    {
      "parameters": {
        "jsCode": "const sheetRows = $('Get Sheet Products').all().map(i => i.json).filter(r => r.sku || r.name);\n\nconst seen = new Set();\nconst wooProducts = $input.all().map(i => i.json)\n  .filter(p => p.id && p.status !== 'trash' && !seen.has(p.id) && seen.add(p.id));\n\n// Safety: sheet khali hole kichu delete hobe na\nif (sheetRows.length === 0) {\n  throw new Error('Sheet is empty - sync aborted to protect store products');\n}\n\nconst strip = (html) => String(html || '').replace(/<[^>]*>/g, '').trim();\n\nconst wooBySku = {};\nwooProducts.forEach(p => { if (p.sku) wooBySku[p.sku] = p; });\n\nconst out = [];\nconst sheetSkus = new Set();\n\nfor (const row of sheetRows) {\n  const sku = String(row.sku || '').trim();\n\n  // IMPORTANT: invalid hole o SKU ta \"sheet e ache\" hishebe dhoro, jeno delete na hoy\n  if (sku) sheetSkus.add(sku);\n\n  const price = parseFloat(row.price);\n  const stock = parseInt(row.stock);\n\n  // Validation\n  if (!sku || isNaN(price) || isNaN(stock) || !row.name) {\n    out.push({ json: { action: 'invalid', sku, reason: 'Missing or invalid sku/name/price/stock', row_number: row.row_number } });\n    continue;\n  }\n\n  const existing = wooBySku[sku];\n  const data = {\n    sku,\n    name: row.name,\n    price: String(price),\n    stock,\n    description: row.description || '',\n    image_url: row.image_url || '',\n    row_number: row.row_number,\n  };\n\n  if (!existing) {\n    out.push({ json: { action: 'create', ...data } });\n  } else {\n    const changed =\n      String(existing.regular_price) !== String(price) ||\n      existing.stock_quantity !== stock ||\n      existing.name !== row.name ||\n      strip(existing.description) !== strip(row.description);\n\n    if (changed) out.push({ json: { action: 'update', id: existing.id, ...data } });\n  }\n}\n\n// Sheet e nai, kintu Woo te ache => delete\nfor (const p of wooProducts) {\n  if (p.sku && !sheetSkus.has(p.sku)) {\n    out.push({ json: { action: 'delete', id: p.id, sku: p.sku, name: p.name } });\n  }\n}\n\nreturn out;\n\nreturn out;"
      },
