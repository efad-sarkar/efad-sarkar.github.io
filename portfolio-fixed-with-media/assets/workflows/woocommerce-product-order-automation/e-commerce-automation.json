      "parameters": {
        "jsCode": "\nconst orders = $input.all().map(item => item.json);\n\nlet totalSales = 0;\nlet totalTax = 0;\nlet totalItemsSold = 0;\n\nfor (const order of orders) {\n  // Cancelled ও failed orders sales হিসেবে ধরব না\n  if (['cancelled', 'failed', 'trash'].includes(order.status)) {\n    continue;\n  }\n\n  totalSales += Number(order.total || 0);\n  totalTax += Number(order.total_tax || 0);\n\n  for (const product of (order.line_items || [])) {\n    totalItemsSold += Number(product.quantity || 0);\n  }\n}\n\nreturn [{\n  json: {\n    report_type: 'Sales Summary',\n    generated_at: new Date().toISOString(),\n    total_orders: orders.length,\n    total_sales: Number(totalSales.toFixed(2)),\n    total_tax_collected: Number(totalTax.toFixed(2)),\n    total_items_sold: totalItemsSold\n  }\n}];\n"
      },
