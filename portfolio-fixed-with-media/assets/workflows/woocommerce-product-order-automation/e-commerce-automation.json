  <tr>\n          <td width=\"50%\" style=\"background:#f5f3ff;border-radius:12px;padding:18px 15px;border:1px solid #ede9fe;\">\n            <div style=\"font-size:11px;color:#7c3aed;font-weight:bold;letter-spacing:1px;\">TAX COLLECTED</div>\n            <div style=\"font-size:25px;font-weight:bold;color:#4c1d95;margin-top:10px;\">৳{{ $json.total_tax_collected }}</div>\n          </td>\n          <td width=\"50%\" style=\"background:#fff7ed;border-radius:12px;padding:18px 15px;border:1px solid #ffedd5;\">\n            <div style=\"font-size:11px;color:#c2410c;font-weight:bold;letter-spacing:1px;\">ITEMS SOLD</div>\n            <div style=\"font-size:27px;font-weight:bold;color:#7c2d12;margin-top:10px;\">{{ $json.total_items_sold }}</div>\n          </td>\n        </tr>\n      </table>\n    </div>\n\n    <div style=\"padding:18px 29px 10px;\">\n      <h2 style=\"font-size:17px;color:#111827;margin:0 0 15px;\">Store Insights</h2>\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;font-size:14px;\">\n        <tr>\n          <td style=\"padding:13px 0;border-bottom:1px solid #e5e7eb;color:#64748b;\">Best-selling product</td>\n          <td style=\"padding:13px 0;border-bottom:1px solid #e5e7eb;text-align:right;font-weight:bold;color:#111827;\">{{ $json.best_selling_product }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:13px 0;border-bottom:1px solid #e5e7eb;color:#64748b;\">Unique customers</td>\n          <td style=\"padding:13px 0;border-bottom:1px solid #e5e7eb;text-align:right;font-weight:bold;color:#111827;\">{{ $json.new_vs_returning_customers.unique_customers }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:13px 0;border-bottom:1px solid #e5e7eb;color:#64748b;\">Repeat customers</td>\n          <td style=\"padding:13px 0;border-bottom:1px solid #e5e7eb;text-align:right;font-weight:bold;color:#111827;\">{{ $json.new_vs_returning_customers.repeat_customers }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:13px 0;color:#64748b;\">Total refunds</td>\n          <td style=\"padding:13px 0;text-align:right;font-weight:bold;color:#dc2626;\">৳{{ $json.total_refunds }}</td>\n        </tr>\n      </table>\n    </div>\n\n    <div style=\"margin:22px 28px;padding:17px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;\">\n      <div style=\"font-size:13px;font-weight:bold;color:#334155;\">Invoice records</div>\n      <p style=\"font-size:12px;line-height:1.7;color:#64748b;margin:8px 0 0;\">\n        This report contains {{ $json.invoice_links.length }} order records. Open your WooCommerce dashboard to review invoices.\n      </p>\n    </div>\n\n    <div style=\"padding:22px 28px;background:#111827;color:#9ca3af;text-align:center;font-size:11px;line-height:1.8;\">\n      <strong style=\"color:#ffffff;letter-spacing:1px;\">ZENVIO</strong><br>\n      Automated Sales Intelligence · Powered by n8n<br>\n      This is an automatically generated report.\n    </div>\n\n  </div>\n</div>\n",
