        "jsCode": "const b=$json.body??$json;\nconst required=[\"client_name\",\"client_email\",\"project_name\"];\nconst missing=required.filter(k=>!String(b[k]??\"\").trim());\nconst safe=(s)=>String(s??\"\").trim().replace(/[\\\\/:*?\"<>|#%{}~&]/g,\"-\").replace(/\\s+/g,\"_\").slice(0,80);\nconst clientFolder=safe(`${b.client_name||\"Client\"}_${b.project_name||\"Project\"}`);\nreturn [{json:{\n  is_valid:missing.length===0,\n  missing_fields:missing,\n  client_name:String(b.client_name??\"\").trim(),\n  client_email:String(b.client_email??\"\").trim(),\n  project_name:String(b.project_name??\"\").trim(),\n  client_folder_name:clientFolder,\n  subfolders:[\"01_Brief\",\"02_Reference_Assets\",\"03_AI_Concepts\",\"04_Final_Creatives\",\"05_Reports\"]\n}}];"
