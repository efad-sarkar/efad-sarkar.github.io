      "parameters": {
        "jsCode": "const created=$input.all().map(i=>({name:i.json.name||i.json.body?.name||\"Folder\",id:i.json.id}));\nconst base=$(\"Validate & Prepare Client Workspace\").first().json;\nconst root=$(\"Google Drive - Create Client Folder\").first().json;\nreturn [{json:{\n  success:true,\n  client_name:base.client_name,\n  client_email:base.client_email,\n  project_name:base.project_name,\n  root_folder_id:root.id,\n  root_folder_url:`https://drive.google.com/drive/folders/${root.id}`,\n  subfolders:created,\n  workspace_status:\"created\"\n}}];"
      },
