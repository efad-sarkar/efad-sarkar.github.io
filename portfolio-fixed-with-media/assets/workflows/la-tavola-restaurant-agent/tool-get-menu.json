      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst wanted = String(body.category || '').trim().toLowerCase().replace(/s$/, '');\n\nlet items = $input.all()\n  .map(i => {\n    const f = i.json.fields ?? i.json;\n    return {\n      item: f['Item'],\n      category: f['Category'],\n      price: f['Price'],\n      description: f['Description'],\n    };\n  })\n  .filter(x => x.item);\n\nif (wanted) {\n  const filtered = items.filter(x => String(x.category || '').toLowerCase().includes(wanted));\n  if (filtered.length) items = filtered;\n}\n\nreturn [{ json: { count: items.length, menu: items } }];"
      },
