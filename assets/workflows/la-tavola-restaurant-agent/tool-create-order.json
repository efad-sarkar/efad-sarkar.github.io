    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nconst norm = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9 ]/g, ' ').replace(/\\s+/g, ' ').trim();\nconst round = (n) => Math.round(n * 100) / 100;\nconst fail = (message, extra = {}) => [{ json: { valid: false, success: false, message, ...extra } }];\n\n// ---- Customer details ----\nconst name = String(b.customer_name || '').trim();\nconst phone = String(b.phone || '').replace(/[^\\d+]/g, '');\nif (!name || phone.length < 6) {\n  return fail(\"I still need the customer's name and phone number to place the order.\");\n}\n\n// ---- Order type ----\nconst typeRaw = norm(b.order_type);\nlet type;\nif (typeRaw.includes('deliver')) type = 'Delivery';\nelse if (typeRaw.includes('pick') || typeRaw.includes('take')) type = 'Pickup';\nelse if (typeRaw.includes('dine') || typeRaw.includes('eat')) type = 'Dine-in';\nelse return fail('I need to know if this order is dine-in, pickup or delivery.');\n\nconst address = String(b.address || '').trim();\nif (type === 'Delivery' && address.length < 5) {\n  return fail('I need the delivery address to place a delivery order.');\n}\n\n// ---- Items ----\nlet requested = b.items;\nif (typeof requested === 'string') {\n  // fallback format: \"2 Margherita Pizza, 1 Tiramisu\"\n  requested = requested.split(/,|;/).map(s => {\n    const m = s.trim().match(/^(\\d+)\\s*x?\\s*(.+)$/i);\n    return m ? { name: m[2], quantity: +m[1] } : { name: s.trim(), quantity: 1 };\n  }).filter(x => x.name);\n}\nif (!Array.isArray(requested) || requested.length === 0) {\n  return fail('I need at least one item to place the order.');\n}\n\nconst menu = $('Get Menu').all().map(i => {\n  const f = i.json.fields ?? i.json;\n  return { item: f['Item'], price: Number(f['Price']), key: norm(f['Item']) };\n}).filter(m => m.item && !isNaN(m.price));\n\nconst lines = [];\nconst unknown = [];\nfor (const r of requested) {\n  const raw = String(r.name ?? r.item ?? '');\n  const key = norm(raw);\n  const qty = Math.max(1, Math.min(20, parseInt(r.quantity, 10) || 1));\n  let hit = menu.find(m => m.key === key);\n  if (!hit && key.length >= 3) {\n    const fuzzy = menu.filter(m => m.key.includes(key) || key.includes(m.key));\n    if (fuzzy.length === 1) hit = fuzzy[0];\n  }\n  if (!hit) { unknown.push(raw); continue; }\n  lines.push({ item: hit.item, qty, price: hit.price, lineTotal: round(hit.price * qty) });\n}\nif (unknown.length) {\n  return fail(\n    `I could not find these on the available menu: ${unknown.join(', ')}. Please ask the customer to choose another item.`,\n    { unknown_items: unknown }\n  );\n}\n\n// ---- Totals (rules from the restaurant info PDF) ----\nconst subtotal = round(lines.reduce((s, l) => s + l.lineTotal, 0));\nif (type === 'Delivery' && subtotal < 15) {\n  return fail('The minimum order for delivery is $15.', { subtotal });\n}\nconst deliveryFee = type === 'Delivery' ? (subtotal > 40 ? 0 : 3) : 0;\nconst total = round(subtotal + deliveryFee);\n\nconst itemsText = lines.map(l => `${l.qty}x ${l.item} ($${l.price.toFixed(2)})`).join('\\n');\n\nreturn [{ json: {\n  valid: true,\n  customer_name: name, phone, order_type: type,\n  address: type === 'Delivery' ? address : '',\n  items_text: itemsText, lines, subtotal,\n  delivery_fee: deliveryFee, total,\n}}];"
      },
