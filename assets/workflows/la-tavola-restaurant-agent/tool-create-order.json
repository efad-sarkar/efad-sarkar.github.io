      "parameters": {
        "jsCode": "const o = $('Build Order').first().json;\nconst rec = $input.first().json;\nconst f = rec.fields ?? rec;\n\nreturn [{\n  json: {\n    success: true,\n    order_id: f['Order ID'],\n    order_type: o.order_type,\n    items: o.lines.map(l => `${l.qty} ${l.item}`),\n    subtotal: o.subtotal,\n    delivery_fee: o.delivery_fee,\n    total: o.total,\n    message: 'Order placed.',\n  },\n}];"
