    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst date = String(body.date || '').trim();      // YYYY-MM-DD\nconst guests = parseInt(body.guests, 10);\n\nconst DURATION = 90;       // minutes per booking\nconst MAX_GUESTS = 8;\nconst MAX_DAYS_AHEAD = 30;\nconst STEP = 30;\n\nconst toMin = (s) => {\n  const m = String(s || '').trim().match(/^(\\d{1,2}):(\\d{2})\\s*(AM|PM)?$/i);\n  if (!m) return null;\n  let h = +m[1];\n  const ap = m[3] && m[3].toUpperCase();\n  if (ap === 'PM' && h < 12) h += 12;\n  if (ap === 'AM' && h === 12) h = 0;\n  return h * 60 + +m[2];\n};\nconst to24 = (m) => String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');\nconst label = (m) => {\n  const h = Math.floor(m / 60), mm = m % 60;\n  const h12 = h % 12 === 0 ? 12 : h % 12;\n  return h12 + ':' + String(mm).padStart(2, '0') + ' ' + (h >= 12 ? 'PM' : 'AM');\n};\nconst reply = (obj) => [{ json: obj }];\n\n// ---- Validation ----\nconst t = toMin(body.time);\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || t === null || !Number.isInteger(guests) || guests < 1) {\n  return reply({ available: false, message: 'I need a valid date, time and number of guests to check availability.' });\n}\nconst today = $now.toFormat('yyyy-MM-dd');\nconst lastDay = $now.plus({ days: MAX_DAYS_AHEAD }).toFormat('yyyy-MM-dd');\nif (date < today) return reply({ available: false, message: 'That date is in the past. Please choose a future date.' });\nif (date > lastDay) return reply({ available: false, message: 'We take bookings up to 30 days ahead.' });\nif (guests > MAX_GUESTS) return reply({ available: false, message: 'I can book up to 8 guests. For larger groups, please call the restaurant.' });\n\n// ---- Opening hours (Sun 13-21, Mon-Thu 12-22, Fri-Sat 12-23) ----\nconst dow = new Date(date + 'T12:00:00').getDay(); // 0 = Sunday\nlet open, close;\nif (dow === 0) { open = 13 * 60; close = 21 * 60; }\nelse if (dow === 5 || dow === 6) { open = 12 * 60; close = 23 * 60; }\nelse { open = 12 * 60; close = 22 * 60; }\nconst lastStart = close - DURATION;\nif (t < open || t > lastStart) {\n  return reply({ available: false, message: `We take bookings between ${label(open)} and ${label(lastStart)} on that day.` });\n}\n\n// ---- Data ----\nconst get = (j) => j.fields ?? j;\nconst tables = $('Get Tables').all().map(i => {\n  const f = get(i.json);\n  return { recordId: i.json.id, tableId: f['Table ID'], seats: Number(f['Seats']), area: f['Area'] };\n}).filter(x => x.tableId && x.seats);\n\nconst booked = $('Get Reservations').all().map(i => {\n  const f = get(i.json);\n  return { tables: f['Table'] || [], min: toMin(f['Time']) };\n}).filter(r => r.min !== null);\n\nconst freeAt = (start) => {\n  const busy = new Set();\n  for (const r of booked) {\n    if (Math.abs(r.min - start) < DURATION) r.tables.forEach(id => busy.add(id));\n  }\n  return tables.filter(x => x.seats >= guests && !busy.has(x.recordId))\n               .sort((a, b) => a.seats - b.seats);\n};\n\n// ---- Requested slot ----\nconst free = freeAt(t);\nif (free.length) {\n  const pick = free[0]; // smallest table that fits\n  return reply({\n    available: true, date, time: to24(t), guests,\n    table_id: pick.tableId, table_record_id: pick.recordId,\n    seats: pick.seats, area: pick.area,\n    message: `A table for ${guests} is available at ${label(t)}.`,\n  });\n}\n\n// ---- Alternatives (nearest times, up to 3) ----\nconst alternatives = [];\nfor (let d = STEP; d <= 120 && alternatives.length < 3; d += STEP) {\n  for (const s of [t - d, t + d]) {\n    if (s >= open && s <= lastStart && alternatives.length < 3 && freeAt(s).length) {\n      alternatives.push({ time: to24(s), label: label(s) });\n    }\n  }\n}\nreturn reply({\n  available: false, date, time: to24(t), guests, alternatives,\n  debug: {\n    tables_found: tables.length,\n    tables_big_enough: tables.filter(x => x.seats >= guests).length,\n    bookings_that_day: booked.length,\n  },\n  message: alternatives.length\n    ? `No table is free at ${label(t)}. Nearest available times: ${alternatives.map(a => a.label).join(', ')}.`\n    : `No table is free around ${label(t)} on that date.`,\n});"
      },
