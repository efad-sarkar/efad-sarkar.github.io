      "parameters": {
        "promptType": "define",
        "text": "=Company: {{ $json.company }}\nJob title: {{ $json.job }}\nWebsite: {{ $json.website }}\nSource: {{ $json.source }}\nJob description:\n{{ $json.description }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You qualify companies as potential leads for an AI automation agency. Based on the job posting, judge how strongly the company shows signs of manual, repetitive, or high-volume processes that AI automation could improve (e.g. data entry, invoice processing, support ticket triage, manual reporting, scheduling, lead handling).\n\nReturn a JSON object with: company, job, website (echo the provided values exactly; if website is empty, infer the likely company homepage), painPoint (the specific manual/repetitive process to target), solution (a concrete AI automation you would propose), decisionMakerRole (the most likely decision-maker to reach), score (0-100 lead quality — higher = clearer automation opportunity and buying signal), source (echo exactly), and outreach (a short, personalized 2-3 sentence outreach message referencing the pain point and solution).\n\nBe strict: only give 70+ to companies with clear, addressable automation opportunities."
        }
      },
