      "typeVersion": 4.2,
      "position": [
        224,
        16
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first() ? $input.first().json : {};\nconst jobs = Array.isArray(res.data) ? res.data : [];\nconst strip = (s) => String(s || '').replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 1500);\nreturn jobs.slice(0, 15).map((j) => ({\n  json: {\n    company: (j.company_name || '').trim(),\n    job: (j.title || '').trim(),\n    website: j.url || '',\n    description: strip(j.description),\n    source: 'Arbeitnow',\n  },\n})).filter((i) => i.json.company && i.json.job);"
      },
      "id": "7d58dfd7-b5f2-4762-a8ad-fb525c16b951",
